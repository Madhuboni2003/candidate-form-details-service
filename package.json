{
  "name": "candidate-form-details-service",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "start:ts": "ts-node src/server.ts",
    "dev": "nodemon src/server.ts",
    "migration:generate": "sequelize-cli migration:generate --name",
    "migrate": "sequelize-cli db:migrate",
    "rollback": "sequelize-cli db:migrate:undo",
    "migrate:prod": "SEQUELIZE_USE_DIST=true sequelize-cli db:migrate",
    "rollback:prod": "SEQUELIZE_USE_DIST=true sequelize-cli db:migrate:undo"
  },
  "keywords": [],
  "author": "",

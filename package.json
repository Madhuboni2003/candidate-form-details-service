  "description": "",
  "dependencies": {
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.10.1",
    "mysql2": "^3.22.3",
    "node-cron": "^4.6.0",
    "redis": "^6.2.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.46"
  },
